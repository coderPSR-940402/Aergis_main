<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="Aergis"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity android:name=".ProductionActivity" android:exported="false" />
        <activity android:name=".PointerCalibrationActivity" android:exported="false" />
        <activity android:name=".GestureMappingActivity" android:exported="false" />

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".GestureCaptureService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <service
            android:name=".AirAccessibilityService"
            android:exported="true"
            android:label="Aergis"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/air_accessibility_service" />
        </service>
    </application>
</manifest>
